# Copy this file to .env for local Netlify development.
# Never put the Supabase service-role key or provider secrets in this file.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated exact origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8443,http://localhost:8888

# Optional API prefix override. Leave empty to use same-origin /api.
VITE_API_BASE_URL=

# Public Supabase values used by the browser authentication UI.
# The anon/publishable key is public; never use the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
